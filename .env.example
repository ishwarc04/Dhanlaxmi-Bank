# FinTrust — Docker Compose environment
# Copy to .env and fill in real values before running

# PostgreSQL
POSTGRES_USER=fintrust
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=fintrust_db

# Backend JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key-in-production

# Frontend API URL (used at build time for Docker image)
VITE_API_URL=http://localhost:8000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
